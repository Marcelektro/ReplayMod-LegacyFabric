@@ -0,0 +1,40 @@
+package de.johni0702.minecraft.gui.versions.callbacks;
+
+import de.johni0702.minecraft.gui.utils.Event;
+
+import java.io.IOException;
+
+/**
+ * Pre-input hooks for the current screen on Minecraft versions where the screens process their own raw
+ * LWJGL input ({@code handleMouse}/{@code handleKeyboard}) and no loader provides an event for it.
+ * Both methods return true if the event was handled, in which case the screen's own handling is skipped.
+ */
+public interface ScreenInputCallback {
+    Event<ScreenInputCallback> EVENT = Event.create((listeners) ->
+            new ScreenInputCallback() {
+                @Override
+                public boolean mouseInput() throws IOException {
+                    for (ScreenInputCallback listener : listeners) {
+                        if (listener.mouseInput()) {
+                            return true;
+                        }
+                    }
+                    return false;
+                }
+
+                @Override
+                public boolean keyboardInput() throws IOException {
+                    for (ScreenInputCallback listener : listeners) {
+                        if (listener.keyboardInput()) {
+                            return true;
+                        }
+                    }
+                    return false;
+                }
+            }
+    );
+
+    boolean mouseInput() throws IOException;
+
+    boolean keyboardInput() throws IOException;
+}
