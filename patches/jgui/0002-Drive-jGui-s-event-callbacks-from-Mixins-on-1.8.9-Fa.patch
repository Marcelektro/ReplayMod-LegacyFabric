@@ -0,0 +1,58 @@
+package de.johni0702.minecraft.gui.versions.mixin;
+
+import de.johni0702.minecraft.gui.versions.callbacks.InitScreenCallback;
+import de.johni0702.minecraft.gui.versions.callbacks.ScreenInputCallback;
+import net.minecraft.client.gui.screen.Screen;
+import net.minecraft.client.gui.widget.ButtonWidget;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.Redirect;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+import java.io.IOException;
+import java.util.List;
+
+/**
+ * Screen related events which Forge provides on legacy versions but Legacy Fabric does not.
+ */
+@Mixin(Screen.class)
+public abstract class MixinLegacyScreen {
+    @Shadow
+    protected List<ButtonWidget> buttons;
+
+    @Shadow
+    public abstract void handleMouse() throws IOException;
+
+    @Shadow
+    public abstract void handleKeyboard() throws IOException;
+
+    @Inject(method = "init(Lnet/minecraft/client/MinecraftClient;II)V",
+            at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/screen/Screen;init()V"))
+    private void jgui_preInit(CallbackInfo ci) {
+        InitScreenCallback.Pre.EVENT.invoker().preInitScreen((Screen) (Object) this);
+    }
+
+    @Inject(method = "init(Lnet/minecraft/client/MinecraftClient;II)V",
+            at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/screen/Screen;init()V", shift = At.Shift.AFTER))
+    private void jgui_postInit(CallbackInfo ci) {
+        InitScreenCallback.EVENT.invoker().initScreen((Screen) (Object) this, this.buttons);
+    }
+
+    @Redirect(method = "handleInput",
+            at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/screen/Screen;handleMouse()V"))
+    private void jgui_handleMouse(Screen self) throws IOException {
+        if (!ScreenInputCallback.EVENT.invoker().mouseInput()) {
+            handleMouse();
+        }
+    }
+
+    @Redirect(method = "handleInput",
+            at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/screen/Screen;handleKeyboard()V"))
+    private void jgui_handleKeyboard(Screen self) throws IOException {
+        if (!ScreenInputCallback.EVENT.invoker().keyboardInput()) {
+            handleKeyboard();
+        }
+    }
+}
