+package com.replaymod.core.utils;
+
+import com.replaymod.replaystudio.data.ModInfo;
+import net.fabricmc.loader.api.FabricLoader;
+import net.fabricmc.loader.api.ModContainer;
+import net.minecraft.block.Block;
+import net.minecraft.item.Item;
+import net.minecraft.util.Identifier;
+
+import java.util.Collection;
+import java.util.Map;
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+import java.util.stream.StreamSupport;
+
+class ModInfoGetter {
+    static Collection<ModInfo> getInstalledNetworkMods() {
+        Map<String, ModInfo> modInfoMap = FabricLoader.getInstance().getAllMods().stream()
+                .map(ModContainer::getMetadata)
+                .map(m -> new ModInfo(m.getId(), m.getName(), m.getVersion().toString()))
+                .collect(Collectors.toMap(ModInfo::getId, Function.identity(), (a, b) -> a));
+        Stream<Identifier> blocks = StreamSupport.stream(((Iterable<Block>) Block.REGISTRY).spliterator(), false)
+                .map(block -> (Identifier) Block.REGISTRY.getIdentifier(block));
+        Stream<Identifier> items = StreamSupport.stream(((Iterable<Item>) Item.REGISTRY).spliterator(), false)
+                .map(item -> (Identifier) Item.REGISTRY.getIdentifier(item));
+        return Stream.concat(blocks, items)
+                .filter(Objects::nonNull)
+                .map(Identifier::getNamespace).filter(s -> !s.equals("minecraft")).distinct()
+                .map(modInfoMap::get).filter(Objects::nonNull)
+                .collect(Collectors.toList());
+    }
+}
