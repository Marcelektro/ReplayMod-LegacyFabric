-        modImplementation("net.legacyfabric.legacy-fabric-api:legacy-fabric-api:1.13.5+1.8.9")
+        // No Fabric API equivalent: loaders for these versions differ too much (Legacy Fabric, Ornithe)
     } else if (platform.isFabric) {
         val fabricApiVersion = when (mcVersion) {
             11404 -> "0.4.3+build.247-1.14"
@@ -392,3 +396,88 @@ val bundleJar by tasks.registering(com.github.jengelman.gradle.plugins.shadow.ta
     }
 }
 tasks.assemble { dependsOn(bundleJar) }
+
+if (legacyFabric) {
+    // We build against Legacy Fabric's mappings (the only ones Loom can currently be pointed at for 1.8.9), but the
+    // loader used by OneClient for 1.8.9 is Ornithe, which names Minecraft's classes differently. So the jar is
+    // translated to Ornithe's names after the fact, see tools/OrnitheRetarget.java.
+    repositories {
+        maven("https://maven.ornithemc.net/releases") {
+            content {
+                includeGroup("net.ornithemc")
+            }
+        }
+    }
+    // OneConfig, which is part of OneClient, is only used to list ReplayMod there (see ReplayModOneConfig)
+    repositories {
+        maven("https://repo.polyfrost.org/releases") {
+            content {
+                includeGroup("org.polyfrost.oneconfig")
+            }
+        }
+    }
+    // (resolved through a configuration of its own: the jars are built for a newer JVM than we compile for, which
+    // would get them filtered out of the compile classpath)
+    val oneConfigApi by configurations.creating {
+        isTransitive = false
+    }
+    dependencies {
+        oneConfigApi("org.polyfrost.oneconfig:config-impl:1.6.2")
+        oneConfigApi("org.polyfrost.oneconfig:config:1.6.2")
+    }
+    // Compiled on its own as it needs Java 21 (see OneConfigSupport). Not a source set, those get picked up by the
+    // preprocessor.
+    val compileOneConfig by tasks.registering(JavaCompile::class) {
+        source(fileTree("src/oneconfig/java"))
+        classpath = sourceSets.main.get().output + sourceSets.main.get().compileClasspath + oneConfigApi
+        destinationDirectory.set(layout.buildDirectory.dir("classes/oneconfig"))
+        options.release.set(21)
+    }
+    tasks.jar {
+        from(compileOneConfig.flatMap { it.destinationDirectory })
+    }
+    val ornitheTool by configurations.creating
+    val legacyFabricIntermediary by configurations.creating
+    val calamusIntermediary by configurations.creating
+    dependencies {
+        ornitheTool("net.fabricmc:tiny-remapper:0.10.3")
+        legacyFabricIntermediary("net.legacyfabric:intermediary:${platform.mcVersionStr}:v2")
+        calamusIntermediary("net.ornithemc:calamus-intermediary-gen2:${platform.mcVersionStr}")
+    }
+
+    val ornitheJar by tasks.registering {
+        group = "build"
+        description = "Converts the bundled jar to Ornithe's Minecraft names"
+
+        val input = bundleJar.flatMap { it.archiveFile }
+        val output = layout.buildDirectory.file("libs/${base.archivesName.get()}-$version-ornithe.jar")
+        val tool = rootProject.file("tools/OrnitheRetarget.java")
+        val mcVersion = platform.mcVersionStr
+        val gradleHome = gradle.gradleUserHomeDir
+        val execOps = project.serviceOf<ExecOperations>()
+        inputs.file(input)
+        inputs.file(tool)
+        inputs.files(ornitheTool, legacyFabricIntermediary, calamusIntermediary)
+        outputs.file(output)
+        doLast {
+            // The obfuscated Minecraft jar, as downloaded by Loom
+            val minecraftJar = listOf("essential-loom", "fabric-loom")
+                .map { gradleHome.resolve("caches/$it/$mcVersion/minecraft-client.jar") }
+                .firstOrNull { it.exists() }
+                ?: throw GradleException("Could not find the Minecraft $mcVersion client jar in Loom's cache")
+            execOps.exec {
+                commandLine(
+                    File(System.getProperty("java.home"), "bin/java").path,
+                    "-cp", ornitheTool.files.joinToString(File.pathSeparator),
+                    tool.path,
+                    input.get().asFile.path,
+                    output.get().asFile.path,
+                    legacyFabricIntermediary.singleFile.path,
+                    calamusIntermediary.singleFile.path,
+                    minecraftJar.path,
+                )
+            }
+        }
+    }
+    tasks.assemble { dependsOn(ornitheJar) }
+}
