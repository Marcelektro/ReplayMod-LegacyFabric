+import org.polyfrost.oneconfig.api.config.v1.annotations.Button;
+
+/**
+ * Makes ReplayMod show up in OneConfig's (and thereby OneClient's) mod list.
+ * ReplayMod keeps its own settings screen and file, so this just links to the screens.
+ */
+public class ReplayModOneConfig extends Config {
+    @Button(
+            title = "Replay Viewer",
+            description = "Browse, play back and edit your replays.",
+            text = "Open"
+    )
+    public static void openReplayViewer() {
+        new GuiReplayViewer(ReplayModReplay.instance).display();
+    }
+
+    @Button(
+            title = "ReplayMod Settings",
+            description = "Opens ReplayMod's own settings screen.",
+            text = "Open"
+    )
+    public static void openSettings() {
+        new GuiReplaySettings(MinecraftClient.getInstance().currentScreen, ReplayMod.instance.getSettingsRegistry()).display();
+    }
+
+    public ReplayModOneConfig() {
+        super("replaymod-oneconfig.json", "ReplayMod", Category.UTILITY);
+    }
+}
