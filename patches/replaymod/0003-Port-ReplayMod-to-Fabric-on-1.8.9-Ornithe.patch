+package com.replaymod.core.versions;
+
+import com.replaymod.core.mixin.GameOptionsAccessor;
+import net.minecraft.client.MinecraftClient;
+import net.minecraft.client.option.GameOptions;
+import net.minecraft.client.option.KeyBinding;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Adds key bindings to the options screen on Minecraft versions where no API for that exists on the loader.
+ * <p>
+ * Mods get initialized before the game options exist, so bindings registered by then are added to the options
+ * right before they load their saved values.
+ */
+public class LegacyKeyBindings {
+    private static final List<KeyBinding> pending = new ArrayList<>();
+
+    public static void register(KeyBinding keyBinding) {
+        GameOptions options = MinecraftClient.getInstance().options;
+        if (options == null) {
+            pending.add(keyBinding);
+        } else {
+            add(options, keyBinding);
+            options.load();
+        }
+    }
+
+    /** Called right before the options load their values for the first time. */
+    public static void applyPending(GameOptions options) {
+        for (KeyBinding keyBinding : pending) {
+            add(options, keyBinding);
+        }
+        pending.clear();
+    }
+
+    private static void add(GameOptions options, KeyBinding keyBinding) {
+        GameOptionsAccessor accessor = (GameOptionsAccessor) options;
+        KeyBinding[] keys = accessor.getAllKeys();
+        KeyBinding[] extended = Arrays.copyOf(keys, keys.length + 1);
+        extended[keys.length] = keyBinding;
+        accessor.setAllKeys(extended);
+    }
+}
