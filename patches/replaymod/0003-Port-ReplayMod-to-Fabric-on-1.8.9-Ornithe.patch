+package com.replaymod.core.oneconfig;
+
+import net.fabricmc.loader.api.FabricLoader;
+import org.apache.logging.log4j.LogManager;
+
+/**
+ * Registers ReplayMod with OneConfig if that is installed.
+ * <p>
+ * The part which depends on OneConfig is compiled separately (it requires a newer Java than the rest of the mod) and
+ * is only ever loaded through here, so nothing breaks when OneConfig is not installed.
+ */
+public class OneConfigSupport {
+    public static void registerIfPresent() {
+        if (!FabricLoader.getInstance().isModLoaded("oneconfigv1")) {
+            return;
+        }
+        try {
+            Class.forName("com.replaymod.core.oneconfig.ReplayModOneConfig").getDeclaredConstructor().newInstance();
+        } catch (Throwable t) {
+            LogManager.getLogger("replaymod/oneconfig").warn("Could not register with OneConfig", t);
+        }
+    }
+}
