+import net.fabricmc.tinyremapper.OutputConsumerPath;
+import net.fabricmc.tinyremapper.TinyRemapper;
+import net.fabricmc.tinyremapper.TinyUtils;
+import net.fabricmc.tinyremapper.extension.mixin.MixinExtension;
+import net.fabricmc.tinyremapper.extension.mixin.common.Logger;
+import org.objectweb.asm.AnnotationVisitor;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.Opcodes;
+
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Enumeration;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+import java.util.zip.ZipOutputStream;
+
+/**
+ * Converts a mod jar that was remapped to Legacy Fabric's intermediary names to Ornithe's (calamus gen2) names.
+ * <p>
+ * Both intermediaries are generated from the same obfuscated Minecraft jar, so the names of one can be translated
+ * to the other via the obfuscated names.
+ * <p>
+ * Usage (java source launcher, tiny-remapper on the classpath):
+ * {@code OrnitheRetarget.java <in.jar> <out.jar> <legacy-fabric-intermediary.jar> <calamus-gen2.jar> <minecraft-client.jar>}
+ * where the last one is the obfuscated Minecraft jar.
+ */
+public class OrnitheRetarget {
+    private static final String MAPPINGS = "mappings/mappings.tiny";
+
+    public static void main(String[] args) throws Exception {
+        if (args.length != 5) {
+            throw new IllegalArgumentException("expected: <in> <out> <lf-intermediary.jar> <calamus.jar> <minecraft.jar>");
+        }
+        Path in = Paths.get(args[0]), out = Paths.get(args[1]);
+        Path work = Files.createTempDirectory("ornithe-retarget");
+        try {
+            String lfTiny = readEntry(Paths.get(args[2]), MAPPINGS);
+            String calamusTiny = readEntry(Paths.get(args[3]), MAPPINGS);
+            Path lfFile = work.resolve("lf.tiny");
+            Files.write(lfFile, lfTiny.getBytes(StandardCharsets.UTF_8));
+
+            Joined joined = join(lfTiny, calamusTiny);
+            Path joinedFile = work.resolve("lf2ornithe.tiny");
+            Files.write(joinedFile, joined.tiny.getBytes(StandardCharsets.UTF_8));
+
+            // Minecraft in Legacy Fabric names, needed to resolve the inheritance of the members the mod uses
+            Path minecraftLf = work.resolve("minecraft-lf.jar");
+            remap(Paths.get(args[4]), minecraftLf, lfFile, "official", "intermediary", null, false);
+
+            Path remapped = work.resolve("remapped.jar");
+            remap(in, remapped, joinedFile, "intermediary", "ornithe", minecraftLf, true);
+
+            postProcess(remapped, out, joined);
+        } finally {
+            try (java.util.stream.Stream<Path> files = Files.walk(work)) {
+                files.sorted(Collections.reverseOrder()).forEach(p -> p.toFile().delete());
+            }
+        }
+    }
+
+    private static String readEntry(Path jar, String name) throws IOException {
+        try (ZipFile zf = new ZipFile(jar.toFile())) {
+            ZipEntry e = zf.getEntry(name);
+            if (e == null) throw new IOException(name + " not found in " + jar);
+            return new String(zf.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8);
+        }
+    }
+
+    private static void remap(Path in, Path out, Path mappings, String from, String to, Path classpath, boolean mixins) throws IOException {
+        TinyRemapper.Builder builder = TinyRemapper.newRemapper()
+                .withMappings(TinyUtils.createTinyMappingProvider(mappings, from, to));
+        if (mixins) builder.extension(new MixinExtension(Logger.Level.ERROR));
+        TinyRemapper remapper = builder.build();
+        try (OutputConsumerPath consumer = new OutputConsumerPath.Builder(out).build()) {
+            consumer.addNonClassFiles(in);
+            remapper.readInputs(in);
+            if (classpath != null) remapper.readClassPath(classpath);
+            remapper.apply(consumer);
+        } finally {
+            remapper.finish();
+        }
+    }
+
+    private static class Joined {
+        String tiny;
+        final Map<String, String> classes = new HashMap<>(); // LF class -> ornithe class
+        final Map<String, String> methods = new HashMap<>(); // LF method_123 -> ornithe name
+        final Map<String, String> fields = new HashMap<>();  // LF field_123 -> ornithe name
+    }
+
+    private static Joined join(String lfTiny, String calamusTiny) {
+        // official -> LF
+        Map<String, String> lfClasses = new LinkedHashMap<>();
+        List<String[]> lfMembers = new ArrayList<>(); // kind, owner (official), name (official), desc (official), LF name
+        String cur = null;
+        for (String line : lfTiny.split("\n")) {
+            String[] p = line.split("\t", -1);
+            if (p[0].equals("c")) {
+                cur = p[1];
+                lfClasses.put(cur, p[2]);
+            } else if (p[0].isEmpty() && p.length >= 5 && (p[1].equals("m") || p[1].equals("f"))) {
+                lfMembers.add(new String[]{p[1], cur, p[3], p[2], p[4]});
+            }
+        }
+        // official -> ornithe (calamus is a v1 file with official names)
+        Map<String, String> calClasses = new HashMap<>();
+        Map<String, String> calMembers = new HashMap<>();
+        for (String line : calamusTiny.split("\n")) {
+            String[] p = line.split("\t", -1);
+            if (p[0].equals("CLASS")) {
+                calClasses.put(p[1], p[2]);
+            } else if (p[0].equals("FIELD")) {
+                calMembers.put("f\t" + p[1] + "\t" + p[3] + "\t" + p[2], p[4]);
+            } else if (p[0].equals("METHOD")) {
+                calMembers.put("m\t" + p[1] + "\t" + p[3] + "\t" + p[2], p[4]);
+            }
+        }
+
+        Joined j = new Joined();
+        Map<String, List<String[]>> byOwner = new HashMap<>();
+        for (String[] m : lfMembers) byOwner.computeIfAbsent(m[1], k -> new ArrayList<>()).add(m);
+        Pattern classRef = Pattern.compile("L([^;]+);");
+        StringBuilder sb = new StringBuilder("tiny\t2\t0\tintermediary\tornithe\n");
+        for (Map.Entry<String, String> c : lfClasses.entrySet()) {
+            String ornithe = calClasses.getOrDefault(c.getKey(), c.getKey());
+            j.classes.put(c.getValue(), ornithe);
+            sb.append("c\t").append(c.getValue()).append('\t').append(ornithe).append('\n');
+            for (String[] m : byOwner.getOrDefault(c.getKey(), Collections.emptyList())) {
+                Matcher matcher = classRef.matcher(m[3]);
+                StringBuilder desc = new StringBuilder();
+                while (matcher.find()) {
+                    matcher.appendReplacement(desc, Matcher.quoteReplacement("L" + lfClasses.getOrDefault(matcher.group(1), matcher.group(1)) + ";"));
+                }
+                matcher.appendTail(desc);
+                String newName = calMembers.getOrDefault(m[0] + "\t" + m[1] + "\t" + m[2] + "\t" + m[3], m[2]);
+                sb.append('\t').append(m[0]).append('\t').append(desc).append('\t').append(m[4]).append('\t').append(newName).append('\n');
+                (m[0].equals("m") ? j.methods : j.fields).putIfAbsent(m[4], newName);
+            }
+        }
+        j.tiny = sb.toString();
+        return j;
+    }
+
+    private static final Pattern CLASS_TOKEN = Pattern.compile("net/minecraft/class_\\d+(?:\\$[\\w$]+)?");
+    private static final Pattern METHOD_TOKEN = Pattern.compile("\\bmethod_\\d+\\b");
+    private static final Pattern FIELD_TOKEN = Pattern.compile("\\bfield_\\d+\\b");
+    private static final Pattern REFMAP_CLASS = Pattern.compile("\"(net\\.minecraft\\.[^\"]+)\"\\s*:\\s*\"(net/minecraft/[^\";:(]+)\"");
+
+    private static String convertTokens(String text, Joined j) {
+        text = replaceAll(CLASS_TOKEN, text, t -> j.classes.getOrDefault(t, t));
+        text = replaceAll(METHOD_TOKEN, text, t -> j.methods.getOrDefault(t, t));
+        return replaceAll(FIELD_TOKEN, text, t -> j.fields.getOrDefault(t, t));
+    }
+
+    private static String replaceAll(Pattern pattern, String text, java.util.function.Function<String, String> f) {
+        Matcher m = pattern.matcher(text);
+        StringBuilder sb = new StringBuilder();
+        while (m.find()) m.appendReplacement(sb, Matcher.quoteReplacement(f.apply(m.group())));
+        m.appendTail(sb);
+        return sb.toString();
+    }
+
+    /**
+     * Mixin refmaps and access wideners reference members by name; the targets of Mixins declared with a string
+     * have to match the refmap.
+     */
+    private static void postProcess(Path in, Path out, Joined j) throws IOException {
+        Map<String, String> targets = new HashMap<>();
+        Map<String, byte[]> converted = new HashMap<>();
+        try (ZipFile zf = new ZipFile(in.toFile())) {
+            for (Enumeration<? extends ZipEntry> e = zf.entries(); e.hasMoreElements(); ) {
+                ZipEntry ze = e.nextElement();
+                String name = ze.getName();
+                if (name.endsWith(".refmap.json") || name.endsWith(".accesswidener")) {
+                    String text = convertTokens(new String(zf.getInputStream(ze).readAllBytes(), StandardCharsets.UTF_8), j);
+                    converted.put(name, text.getBytes(StandardCharsets.UTF_8));
+                    Matcher m = REFMAP_CLASS.matcher(text);
+                    while (m.find()) targets.put(m.group(1), m.group(2));
+                }
+            }
+        }
+        int[] rewritten = {0};
+        try (ZipFile zf = new ZipFile(in.toFile()); OutputStream os = Files.newOutputStream(out); ZipOutputStream zo = new ZipOutputStream(os)) {
+            for (Enumeration<? extends ZipEntry> e = zf.entries(); e.hasMoreElements(); ) {
+                ZipEntry ze = e.nextElement();
+                byte[] data = converted.containsKey(ze.getName()) ? converted.get(ze.getName()) : zf.getInputStream(ze).readAllBytes();
+                if (ze.getName().endsWith(".class") && !targets.isEmpty()) data = fixMixinTargets(data, targets, rewritten);
+                ZipEntry ne = new ZipEntry(ze.getName());
+                zo.putNextEntry(ne);
+                zo.write(data);
+                zo.closeEntry();
+            }
+        }
+        System.out.println("Wrote " + out.getFileName() + " with Ornithe names (" + rewritten[0] + " mixin target strings rewritten)");
+    }
+
+    private static byte[] fixMixinTargets(byte[] classFile, Map<String, String> targets, int[] rewritten) {
+        ClassReader reader = new ClassReader(classFile);
+        ClassWriter writer = new ClassWriter(0);
+        boolean[] changed = {false};
+        reader.accept(new ClassVisitor(Opcodes.ASM9, writer) {
+            @Override
+            public AnnotationVisitor visitAnnotation(String desc, boolean visible) {
+                AnnotationVisitor av = super.visitAnnotation(desc, visible);
+                if (!desc.equals("Lorg/spongepowered/asm/mixin/Mixin;")) return av;
+                return new AnnotationVisitor(Opcodes.ASM9, av) {
+                    @Override
+                    public AnnotationVisitor visitArray(String name) {
+                        AnnotationVisitor array = super.visitArray(name);
+                        if (!"targets".equals(name)) return array;
+                        return new AnnotationVisitor(Opcodes.ASM9, array) {
+                            @Override
+                            public void visit(String n, Object value) {
+                                if (value instanceof String) {
+                                    String replacement = targets.get(((String) value).replace('/', '.'));
+                                    if (replacement != null) {
+                                        value = replacement;
+                                        changed[0] = true;
+                                        rewritten[0]++;
+                                    }
+                                }
+                                super.visit(n, value);
+                            }
+                        };
+                    }
+                };
+            }
+        }, 0);
+        return changed[0] ? writer.toByteArray() : classFile;
+    }
+}
